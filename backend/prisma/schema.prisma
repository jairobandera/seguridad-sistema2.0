generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  GUARDIA
  CLIENTE
}

enum RolCasa {
  DUENO
  FAMILIAR
}

enum Severidad {
  INFO
  ALERTA
  CRITICA
}

enum EstadoAtencion {
  PENDIENTE
  EN_CURSO
  RESUELTO
  FALSA_ALARMA
}

// BARRIO: casa dentro de un barrio (con o sin guardia). INDIVIDUAL: casa suelta, sin guardia.
enum Paquete {
  BARRIO
  INDIVIDUAL
}

model Barrio {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique
  tieneGuardia   Boolean  @default(true)
  activo         Boolean  @default(true)
  // Código que el admin comparte con los vecinos para registrarse en este barrio (ej. B-7K2QX9)
  codigoRegistro String?  @unique
  creadoEn       DateTime @default(now())

  casas    Casa[]
  guardias GuardiaBarrio[]
}

// Barrios que cubre cada guardia (uno puede cubrir varios)
model GuardiaBarrio {
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  barrioId  Int
  barrio    Barrio  @relation(fields: [barrioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, barrioId])
  @@index([barrioId])
}

// Una sola fila: /api/salud la actualiza en cada llamada (actividad real para que la base no se apague)
model Latido {
  id       Int      @id
  ultimo   DateTime
  llamadas Int      @default(0)
}

model Usuario {
  id                  Int      @id @default(autoincrement())
  nombre              String
  apellido            String
  email               String   @unique
  telefono            String?
  passwordHash        String
  rol                 Rol
  activo              Boolean  @default(true)
  debeCambiarPassword Boolean  @default(false)
  tokenVersion        Int      @default(0)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  membresias       CasaMiembro[]
  contactos        ContactoEmergencia[]
  notificaciones   Notificacion[]
  sesiones         Sesion[]
  pushTokens       PushToken[]
  codigos          CodigoVinculacion[]
  eventosAtendidos EventoEstado[]       @relation("GuardiaEventos")
  eventosGenerados Evento[]             @relation("EventoUsuario")
  barriosGuardia   GuardiaBarrio[]
  recuperaciones   RecuperacionPassword[]
}

model Casa {
  id                Int      @id @default(autoincrement())
  codigo            String   @unique
  nombre            String?
  calle             String?
  numero            String?
  manzana           String?
  paquete           Paquete  @default(BARRIO)
  barrioId          Int?
  barrio            Barrio?  @relation(fields: [barrioId], references: [id], onDelete: SetNull)
  alarmaArmada      Boolean  @default(false)
  retardoEntradaSeg Int      @default(0)
  // Código que el dueño comparte para que se registren sus familiares (ej. F-4HT8WQ)
  codigoFamilia     String?  @unique
  activa            Boolean  @default(true)
  creadoEn          DateTime @default(now())

  miembros     CasaMiembro[]
  dispositivos Dispositivo[]
  camaras      Camara[]
  eventos      Evento[]
  codigos      CodigoVinculacion[]

  @@index([barrioId])
}

model CasaMiembro {
  id        Int      @id @default(autoincrement())
  rol       RolCasa
  creadoEn  DateTime @default(now())
  casaId    Int
  casa      Casa     @relation(fields: [casaId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([casaId, usuarioId])
  @@index([usuarioId])
}

model Dispositivo {
  id              Int       @id @default(autoincrement())
  deviceId        String    @unique
  nombre          String?
  tipo            String?
  firmwareVersion String?
  online          Boolean   @default(false)
  ultimaConexion  DateTime?
  wifiSsid        String?
  wifiRssi        Int?
  bateria         Int?
  bateriaMv       Int?
  // Último aviso de batería baja enviado (20 o 10 %); se borra al pasar el 30 % (cargada)
  avisoBateria    Int?
  ip              String?
  puertaAbierta   Boolean?
  // Armado parcial: quedó afuera de la alarma en este armado (se limpia al desarmar)
  excluidoAlarma  Boolean   @default(false)
  secretEnc       String?   @db.Text
  mqttUsername    String?   @unique
  mqttPassHash    String?
  vinculadoEn     DateTime?
  ultimoSeq       Int       @default(0)
  creadoEn        DateTime  @default(now())

  casaId Int?
  casa   Casa? @relation(fields: [casaId], references: [id], onDelete: SetNull)

  eventos Evento[]
}

model CodigoVinculacion {
  id                Int       @id @default(autoincrement())
  codigoHash        String    @unique
  expiraEn          DateTime
  usadoEn           DateTime?
  creadoEn          DateTime  @default(now())
  // Nombre que eligió el dueño para el dispositivo ("Puerta trasera")
  nombreDispositivo String?
  casaId            Int
  casa              Casa      @relation(fields: [casaId], references: [id], onDelete: Cascade)
  usuarioId         Int
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

/// Código de 6 dígitos que llega por email para restablecer la contraseña ("Olvidé mi contraseña")
model RecuperacionPassword {
  id         Int       @id @default(autoincrement())
  codigoHash String
  expiraEn   DateTime
  intentos   Int       @default(0)
  usadoEn    DateTime?
  creadoEn   DateTime  @default(now())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Evento {
  id           Int       @id @default(autoincrement())
  tipo         String
  severidad    Severidad @default(INFO)
  valor        String?
  fechaHora    DateTime  @default(now())
  recibidoEn   DateTime  @default(now())
  origen       String?
  seq          Int?
  alarmaArmada Boolean   @default(false)

  dispositivoId Int?
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: SetNull)
  casaId        Int?
  casa          Casa?        @relation(fields: [casaId], references: [id], onDelete: SetNull)
  usuarioId     Int?
  usuario       Usuario?     @relation("EventoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  notificaciones Notificacion[]
  estado         EventoEstado?

  @@index([casaId, fechaHora])
  @@index([tipo, fechaHora])
  @@index([dispositivoId, fechaHora])
}

model EventoEstado {
  id         Int            @id @default(autoincrement())
  estado     EstadoAtencion @default(PENDIENTE)
  nota       String?        @db.Text
  tomadoEn   DateTime?
  resueltoEn DateTime?

  eventoId  Int      @unique
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  guardiaId Int?
  guardia   Usuario? @relation("GuardiaEventos", fields: [guardiaId], references: [id], onDelete: SetNull)

  @@index([estado])
}

model ContactoEmergencia {
  id        Int     @id @default(autoincrement())
  nombre    String
  telefono  String
  relacion  String?
  activo    Boolean @default(true)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  tipo      String
  mensaje   String   @db.Text
  canal     String?
  destino   String?
  entregado Boolean  @default(false)
  error     String?  @db.Text
  enviadoEn DateTime @default(now())

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  eventoId  Int?
  evento    Evento?  @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  @@index([eventoId])
}

model Sesion {
  id          Int       @id @default(autoincrement())
  refreshHash String    @unique
  ip          String?
  userAgent   String?   @db.Text
  inicio      DateTime  @default(now())
  ultimoUso   DateTime?
  expiracion  DateTime
  activa      Boolean   @default(true)
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model PushToken {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  plataforma    String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Camara {
  id        Int     @id @default(autoincrement())
  nombre    String
  urlRTSP   String? @db.Text
  urlWebRTC String? @db.Text
  activa    Boolean @default(true)
  tipo      String?
  casaId    Int
  casa      Casa    @relation(fields: [casaId], references: [id], onDelete: Cascade)
}
