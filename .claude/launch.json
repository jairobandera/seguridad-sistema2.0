{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "app",
      "port": 8081
    },
    {
      "name": "app-web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14.2.4",
        "dist",
        "--single",
        "--listen",
        "8095"
      ],
      "cwd": "app",
      "port": 8095,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "pnpm@10.34.7",
        "dev"
      ],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "app-web-local",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:EXPO_PUBLIC_API_URL='http://localhost:3000'; npx expo start --web --port 8081"
      ],
      "cwd": "app",
      "port": 8081
    }
  ]
}
